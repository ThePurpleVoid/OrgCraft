# What .github/workflows/deploy.yml reads. Names only. Set them in GitHub: Settings → Environments → production.

# Secrets (environment "production" → Environment secrets)
FLY_API_TOKEN=            # `fly tokens create deploy --app <FLY_APP>`: scoped to the control plane app, never an org token
FLY_RUNNER_API_TOKEN=     # `fly tokens create deploy --app <FLY_APP>-runner`: scoped to the runner app
VERCEL_TOKEN=             # Vercel account token (Account Settings → Tokens)
DATABASE_URL=             # see deploy/env/server.env.example
AGENT_TEAM_MASTER_KEY=    # see deploy/env/server.env.example
AGENT_TEAM_ADMIN_TOKEN=   # see deploy/env/server.env.example
AGENT_TEAM_EDGE_SECRET=   # openssl rand -base64 32; the workflow stages it on Fly and in the Vercel project. see deploy/env/server.env.example
AGENT_TEAM_STEP_UP_SECRET_HASH=   # M3 exit; optional before. see deploy/env/server.env.example
ANTHROPIC_API_KEY=        # runner only, after the M3 exit; set a daily spend cap in the Anthropic console first
AGENT_TEAM_RUNNER_KEY=    # runner only; from `node deploy/fly/register-runner.mjs --server https://<FLY_APP>.fly.dev`

# Variables (Settings → Secrets and variables → Actions → Variables; not secret)
AGENT_TEAM_DEPLOY=on              # the switch: the workflow does nothing until this is "on"
AGENT_TEAM_RUNNER=on              # the runner's switch, after the M3 exit (deploys <FLY_APP>-runner)
FLY_APP=                          # globally unique Fly app name, e.g. <you>-agent-team (the API is https://<FLY_APP>.fly.dev)
FLY_REGION=iad                    # optional, next to the Supabase region (iad = us-east-1)
VERCEL_PROJECT=                   # Vercel project name; created by the workflow if missing
VERCEL_SCOPE=                     # optional, a Vercel team slug (leave empty for a personal account)
AGENT_TEAM_PUBLIC_URL=            # optional, defaults to https://<VERCEL_PROJECT>.vercel.app
AGENT_TEAM_TENANT=main            # optional
