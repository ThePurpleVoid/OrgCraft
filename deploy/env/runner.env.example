# The runner (data plane, apps/runner/Dockerfile). Names only: never commit values.
# The image sets its own sandbox settings (AGENT_TEAM_RUNNER_DATA, AGENT_TEAM_RUNNER_WORK, AGENT_TEAM_SANDBOX_*).

# Where the runner connects (outbound WebSocket, straight to the container, never through Vercel).
AGENT_TEAM_SERVER=
# The runner key from `agent-team-runner register --code …` (one-time code from the Studio). Tenant-scoped, revocable.
AGENT_TEAM_RUNNER_KEY=
# The model key, held only on the runner. The chief of staff asks the owner for it with a daily spend cap.
ANTHROPIC_API_KEY=
# Pushing branches and opening PRs on the team's repositories: the GitHub App (M4, not read yet).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
AGENT_TEAM_RUNNER_GITCONFIG=  # optional, a git config inside /data/runner whose credential helper uses a branch-push-only token
