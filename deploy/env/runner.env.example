# The runner (data plane, apps/runner/Dockerfile). Names only: never commit values. Draft until apps/runner lands
# (M3, ai-engineer); the names below follow docs/contracts/runner-protocol.md and are confirmed when it does.

# Where the runner connects (outbound WebSocket, straight to the container, never through Vercel).
AGENT_TEAM_SERVER_URL=
# The runner key from `agent-team runner register --code …` (one-time code from the Studio). Tenant-scoped, revocable.
AGENT_TEAM_RUNNER_KEY=
# The model key, held only on the runner. The chief of staff asks the owner for it with a daily spend cap.
ANTHROPIC_API_KEY=
# Pushing branches and opening PRs on the team's repositories: the GitHub App (M4), or until then a fine-grained token.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
