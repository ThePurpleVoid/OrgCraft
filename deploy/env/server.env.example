# The control plane container (apps/server, deploy/server/Dockerfile). Names only: never commit values.
# On our hosted instance these are GitHub "production" environment secrets that the deploy workflow stages on Fly.io.
# Anywhere else: your host's secret store (Render, Railway, Kubernetes Secret, Compose .env kept out of Git).

# Postgres 15+. On Supabase: the Session pooler string (port 5432) for the agent_team_owner login from
# deploy/supabase/bootstrap.sql, with ?sslmode=require&uselibpqcompat=true appended. Not the transaction pooler (6543):
# the server is always on and holds a small pool of its own.
DATABASE_URL=
# 32 random bytes, base64 (openssl rand -base64 32). Seals the vault. Losing it loses every stored secret; rotate by
# re-entering secrets.
AGENT_TEAM_MASTER_KEY=
# Bearer token for people until GitHub sign-in (M4). openssl rand -base64 32. Keep it in your password manager.
AGENT_TEAM_ADMIN_TOKEN=

# Not secret (the deploy workflow sets these as plain environment):
# AGENT_TEAM_PUBLIC_URL=https://<your-site>      the one public host (the Vercel site, which rewrites /v1 here)
# AGENT_TEAM_TENANT=main                          the tenant people sign in to
# DATABASE_POOL=5                                 connections per instance; keep under the pooler's pool size
# PORT=8080  HOST=0.0.0.0                         set by the image
# ALLOW_DESTRUCTIVE=1                             only for a deploy the owner approved (deploy/server/migrate.mjs)
