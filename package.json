{
  "name": "orgcraft",
  "version": "0.21.0",
  "description": "Run a company of Claude Code agents on your repository: role briefs, protocols, a board and the scripts that hold them together.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThePurpleVoid/OrgCraft.git"
  },
  "bin": {
    "orgcraft": "bin/agent-team.mjs",
    "agent-team": "bin/agent-team.mjs"
  },
  "exports": {
    "./studio/handler": "./apps/studio/handler.mjs",
    "./studio/github-app-token": "./apps/studio/github-app-token.mjs",
    "./team-model": "./packages/team-model/index.mjs",
    "./github-app": "./packages/github-app/index.mjs",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "apps/studio/",
    "bin/",
    "packages/events/",
    "packages/github-app/",
    "packages/model-prices/",
    "packages/team-model/",
    "presets/",
    "scripts/*.sh",
    "team/",
    "templates/",
    "tools/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "env -u TEAM_REPORT_URL -u TEAM_REPORT_TOKEN -u TEAM_BOARD_URL -u TEAM_READ_TOKEN -u DASHBOARD_TOKEN node --test tests/*.test.mjs && bash tests/scripts.test.sh"
  }
}
